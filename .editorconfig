root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 88

[*.{csv,tsv}]
# translation cells may legitimately end in a space
trim_trailing_whitespace = false

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{nsi,ps1,bat}]
end_of_line = crlf
indent_size = 2
